#!/usr/bin/env python3
"""
Fullscreen-Splash der erscheint wenn /var/picotron/picotron fehlt.
Beendet sich automatisch sobald das Binary auftaucht (inotify + Poll-Fallback).
"""
import sys
import os
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gio, GLib

PICOTRON_BIN = "/var/picotron/picotron"
PICOTRON_DIR = "/var/picotron"

CSS = b"""
window {
    background-color: #1a1a2e;
}
.message {
    color: #e0e0e0;
    font-size: 28px;
    font-family: monospace;
}
.hint {
    color: #888888;
    font-size: 16px;
    font-family: monospace;
    margin-top: 16px;
}
"""


class SplashApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="de.skutter.picotron-splash")
        self._monitor = None

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self, fullscreened=True)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)

        label = Gtk.Label(label="Please insert device\nwith Picotron data")
        label.set_justify(Gtk.Justification.CENTER)
        label.add_css_class("message")

        hint = Gtk.Label(label="(partition label: PICOTRON)")
        hint.add_css_class("hint")

        box.append(label)
        box.append(hint)
        win.set_child(box)

        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            win.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        win.present()
        self._setup_watcher()

    def _binary_found(self):
        if os.path.isfile(PICOTRON_BIN) and os.access(PICOTRON_BIN, os.X_OK):
            self.quit()
            return True
        return False

    def _setup_watcher(self):
        if self._binary_found():
            return

        try:
            d = Gio.File.new_for_path(PICOTRON_DIR)
            d.make_directory_with_parents(None)
        except GLib.Error:
            pass

        monitor = Gio.File.new_for_path(PICOTRON_DIR).monitor_directory(
            Gio.FileMonitorFlags.NONE, None
        )
        monitor.connect("changed", self._on_dir_changed)
        self._monitor = monitor

        GLib.timeout_add(2000, self._poll)

    def _on_dir_changed(self, monitor, file, other, event_type):
        self._binary_found()

    def _poll(self):
        if self._binary_found():
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE


app = SplashApp()
sys.exit(app.run(None))
