#!/bin/bash
# Greeter-Wrapper für greetd.
# Prüft ob Picotron installiert ist:
#   nein → Splash anzeigen, bei Erfolg neu prüfen
#   ja   → Picotron Login-Cart starten

PICOTRON_BIN="/var/picotron/picotron"
LOGIN_CART="/usr/share/picotron/login.p64"

while true; do
    if [ -x "$PICOTRON_BIN" ]; then
        exec cage -- "$PICOTRON_BIN" --cart "$LOGIN_CART"
    else
        cage -- /usr/bin/picotron-wait-splash
        # Splash hat sich beendet (Binary gefunden) → Schleife prüft erneut
    fi
done
