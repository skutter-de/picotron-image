#!/bin/bash
set -euo pipefail

DEVICE="/dev/${1:?No device given}"
MOUNT_DIR="/run/picotron-import"
INSTALL_DIR="/var/picotron"
MARKER="$INSTALL_DIR/.imported"

if [ -f "$MARKER" ]; then
    echo "Picotron already installed, skipping $DEVICE"
    exit 0
fi

cleanup() {
    umount "$MOUNT_DIR" 2>/dev/null || true
    rmdir "$MOUNT_DIR" 2>/dev/null || true
}
trap cleanup EXIT

mkdir -p "$MOUNT_DIR"
mount -o ro "$DEVICE" "$MOUNT_DIR"

# Validate: Picotron binary must be present
if [ ! -f "$MOUNT_DIR/picotron" ]; then
    echo "No Picotron binary found on $DEVICE, skipping"
    exit 1
fi

echo "Importing Picotron data from $DEVICE to $INSTALL_DIR ..."
mkdir -p "$INSTALL_DIR"
cp -a "$MOUNT_DIR"/. "$INSTALL_DIR/"
chmod 755 "$INSTALL_DIR/picotron"

touch "$MARKER"
echo "Import complete"
