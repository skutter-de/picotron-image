#!/usr/bin/env python3
"""
Picotron Control Center Daemon — läuft als systemd user unit.
Lauscht auf localhost:2424, erreichbar von Picotron via fetch().
Privilegierte Operationen später via separatem System-Daemon.
"""
import os
import platform
import subprocess
import time
from flask import Flask, jsonify

PORT = int(os.environ.get("PICOTRON_DAEMON_PORT", 2424))

app = Flask(__name__)


def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


@app.route("/health")
def health():
    return jsonify({"status": "ok"})


@app.route("/system/info")
def system_info():
    uptime_seconds = None
    raw = _read("/proc/uptime")
    if raw:
        uptime_seconds = int(float(raw.split()[0]))

    os_release = {}
    raw = _read("/etc/os-release")
    if raw:
        for line in raw.splitlines():
            if "=" in line:
                k, _, v = line.partition("=")
                os_release[k] = v.strip('"')

    return jsonify({
        "hostname": platform.node(),
        "os_name": os_release.get("PRETTY_NAME", platform.system()),
        "kernel": platform.release(),
        "uptime_seconds": uptime_seconds,
    })


@app.route("/user/info")
def user_info():
    return jsonify({
        "username": os.environ.get("USER", ""),
        "home": os.environ.get("HOME", ""),
        "uid": os.getuid(),
    })


if __name__ == "__main__":
    app.run(host="127.0.0.1", port=PORT)
