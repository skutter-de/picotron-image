[Unit]
Description=Import Picotron installation from %i
After=local-fs.target
# Prevent double-start if multiple partitions appear at the same time
ConditionPathExists=!/var/picotron/.imported

[Service]
Type=oneshot
ExecStart=/usr/bin/picotron-import %i
StandardOutput=journal
StandardError=journal
SyslogIdentifier=picotron-import
